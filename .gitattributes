# 统一行尾：文本文件一律 LF，避免跨平台 diff 噪声
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf
*.txt  text eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制（不需要行尾转换）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.gz   binary
*.db   binary
